# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
POSTGRES_USER=shadowcut
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=wiki
# Spanner emulator coordinates (PGAdapter auto-creates the database on first connect)
SPANNER_PROJECT=emulator-project
SPANNER_INSTANCE=test-instance
SPANNER_DATABASE=wiki
# Contact for Wikimedia's User-Agent policy (https://meta.wikimedia.org/wiki/User-Agent_policy)
WIKI_UA_CONTACT=set-your-contact-here
# Optional Layer 4 (Vertex AI). Leave empty to use the mock explainer.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
